# ============================================================
# 环境变量示例文件
# ------------------------------------------------------------
# 用法：复制本文件为 .env，再把下面的占位值替换为你的真实值
#   cp .env.example .env        (Linux/macOS/Git Bash)
#   copy .env.example .env      (Windows CMD)
#
# 注意：.env 会被 .gitignore 忽略，不会上传 GitHub，请放心填写真实值
# ============================================================

# ---- Django 核心 ----
# 生成新密钥（复制下面整行到终端执行，把输出粘到等号右侧，保留单引号）：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 值含 $ 等特殊字符，必须保留外层单引号
DJANGO_SECRET_KEY='用上面命令生成的随机密钥'
# 开发用 True；生产部署必须改为 False
DEBUG=True
# 允许访问的主机名，多个用逗号分隔
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- MySQL 数据库 ----
DB_NAME=ml_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- 初始化超级管理员（python manage.py initadmin 读取）----
# 建议改成强口令，不要使用示例值
INITADMIN_USERNAME=admin
INITADMIN_PASSWORD=change_this_strong_password
