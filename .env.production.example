# ============================================================
# 生产环境变量模板（Linux 服务器 / 宝塔部署）
# ------------------------------------------------------------
# 用法：复制为 .env 并替换占位值
#   cp .env.production.example .env
#
# 与 Windows 开发 .env 的区别：Celery 走 Redis、DEBUG=False、ALLOWED_HOSTS 为公网IP/域名
# 详细对照见 deploy/DEPLOY.md
# ============================================================

# ---- Django 核心 ----
# 生成新密钥（在服务器终端执行，把输出粘到等号右侧，保留单引号）：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY='替换为新生成的随机密钥'
# 生产必须 False
DEBUG=False
# 允许访问的主机：公网 IP 和域名都填，逗号分隔（不含 http:// 前缀）
ALLOWED_HOSTS=你的公网IP,your-domain.com

# ---- MySQL 8.0 数据库 ----
# 与 deploy/setup_mysql8.sql 中创建的库/用户一致
DB_NAME=ml_db
DB_USER=ml_user
DB_PASSWORD=你的强口令
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- Celery（Redis broker，生产异步处理）----
# 宝塔软件商店安装 Redis 7.2，默认监听 127.0.0.1:6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Linux 用 prefork 池实现多进程并行训练（Windows 必须 solo，故开发 .env 不填此项）
CELERY_WORKER_POOL=prefork
# 并发 worker 数，按服务器 CPU 核数调（2 核机器填 2，4 核填 3~4）
# ⚠️ 2核4G 小内存机器建议填 1，避免两个训练同时跑导致 OOM（见部署指南附录B）
CELERY_WORKER_CONCURRENCY=2

# ---- Gunicorn（Web 进程 worker 数）----
# gunicorn_conf.py 读取。2核4G 强烈建议 2（不设则默认 2*CPU+1=5 个 worker，吃满内存）
GUNICORN_WORKERS=2

# ---- CSRF 信任来源（必须带 http:// 或 https:// scheme）----
# HTTP+公网IP 验证阶段：http://你的公网IP
# 上 HTTPS 域名后：https://your-domain.com  （多个逗号分隔）
CSRF_TRUSTED_ORIGINS=http://你的公网IP

# ---- HTTPS 反代识别（可选）----
# 上 HTTPS 后设为 true；纯 HTTP 验证阶段留空
SECURE_PROXY_SSL_HEADER=

# ---- 初始化超级管理员（python manage.py initadmin 读取）----
INITADMIN_USERNAME=admin
INITADMIN_PASSWORD=替换为强口令
